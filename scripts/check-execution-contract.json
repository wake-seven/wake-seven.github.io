{
  "schemaVersion": 1,
  "description": "開発者・サブエージェントが変更範囲に応じて守る検査実行契約。",
  "scopes": {
    "clean": { "profile": "fast", "mustRun": ["build", "version", "architecture-guide", "browser-flow"], "mustNotRun": ["device-e2e"], "fullGateRequired": false },
    "documentation": { "profile": "fast", "mustRun": ["build", "version", "architecture-guide"], "mustNotRun": ["device-e2e"], "fullGateRequired": false },
    "source": { "profile": "affected", "mustRun": ["build", "browser-flow", "browser-e2e"], "mustNotRun": ["device-e2e"], "fullGateRequired": false },
    "sensitive": { "profile": "full", "mustRun": ["check:gate", "browser-e2e", "device-e2e"], "mustNotRun": ["check:fast", "check:affected"], "fullGateRequired": true }
  },
  "rules": [
    { "scope": "sensitive", "paths": ["scripts/", "package.json", "package-lock.json", "src/state/", "src/runtime/", "src/commands/", "src/app/", "src/ui/progression", "src/index.template.html", "index.html"] },
    { "scope": "source", "paths": ["src/", "styles/", "public/"] },
    { "scope": "documentation", "paths": ["docs/", "README.md", ".md"] }
  ],
  "policy": { "precedence": ["sensitive", "source", "documentation", "clean"], "unknownChanges": "source", "incompleteIsSuccess": false }
}
