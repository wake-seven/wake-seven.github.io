{
  "schemaVersion": 1,
  "description": "変更領域から、最小確認・影響範囲確認・全体確認へ昇格する対応表。check:gateは常にfullを実行する。",
  "tiers": ["fast", "affected", "full"],
  "areas": {
    "ui/progression": {
      "paths": ["src/ui/progression-", "src/ui/progression.js"],
      "fast": ["progression-flows", "progression-flow-contract"],
      "affected": ["progression-flows", "progression-flow-contract", "dialog-chains", "browser-flow", "browser-e2e"],
      "full": ["progression-flows", "progression-flow-contract", "progression-orchestrators", "clear-flow-order", "progression-responsibility", "dialog-chains", "browser-flow", "browser-e2e", "device-e2e"],
      "promoteToAffectedWhen": ["ダイアログ・進行先・称号・ステージ選択を変更", "公開イベントまたはDOM IDを変更"],
      "promoteToFullWhen": ["共有状態・保存・manifest・公開生成物を変更", "クリア後遷移または二周目を変更"],
      "relatedE2E": ["browser-e2e", "device-e2e", "progression-flows", "clear-flow-order"]
    },
    "clear-flow": {
      "paths": ["src/ui/clear-flow.js", "src/ui/progression-clear-flow.js", "src/ui/progression-flow-contract.js"],
      "fast": ["clear-flow-order", "progression-flow-contract"],
      "affected": ["clear-flow-order", "progression-flow-contract", "dialog-chains", "browser-flow", "browser-e2e"],
      "full": ["clear-flow-order", "progression-flow-contract", "dialog-chains", "progression-flows", "progression-orchestrators", "browser-flow", "browser-e2e", "device-e2e"],
      "promoteToAffectedWhen": ["クリア演出・ダイアログ・クイズ順序を変更"],
      "promoteToFullWhen": ["次問題・次コース・速解き・二周目の遷移を変更"],
      "relatedE2E": ["clear-flow-order", "browser-e2e", "device-e2e"]
    },
    "state": {
      "paths": ["src/state/", "src/commands/state-"],
      "fast": ["state", "state-classification"],
      "affected": ["state", "state-classification", "state-mutations", "state-restore", "browser-flow", "browser-e2e"],
      "full": ["state", "state-classification", "state-mutations", "state-restore", "global-access", "state-access-policy", "temporary-exceptions", "state-access-final-audit", "navigation-classification", "navigation-final-audit", "browser-flow", "browser-e2e", "device-e2e"],
      "promoteToAffectedWhen": ["保存キー・復元・状態commandを変更"],
      "promoteToFullWhen": ["公開state API・navigation gateway・保存形式を変更"],
      "relatedE2E": ["state-restore", "browser-e2e", "device-e2e"]
    },
    "runtime/speed": {
      "paths": ["src/runtime/speed.js", "src/runtime/app-events.js"],
      "fast": ["application-services", "progression-flows"],
      "affected": ["application-services", "progression-flows", "dialog-chains", "browser-e2e"],
      "full": ["application-services", "progression-flows", "clear-flow-order", "dialog-chains", "browser-e2e", "device-e2e", "state-restore"],
      "promoteToAffectedWhen": ["速解き開始・停止・再開・終了・試験を変更"],
      "promoteToFullWhen": ["speed variant・二周目・保存復元・共有navigationを変更"],
      "relatedE2E": ["browser-e2e", "device-e2e", "state-restore"]
    },
    "scripts/manifest": {
      "paths": ["scripts/application-manifest.mjs", "scripts/check-pipeline.json", "scripts/change-check-map.json", "scripts/build-"],
      "fast": ["development-entrypoints", "esm"],
      "affected": ["development-entrypoints", "esm", "public-esm", "manifest-dependencies"],
      "full": ["build", "development-entrypoints", "esm", "public-esm", "manifest-dependencies", "report-schema", "browser-e2e", "device-e2e"],
      "promoteToAffectedWhen": ["連結順・公開ファイル・検査定義を変更"],
      "promoteToFullWhen": ["公開index.htmlの生成経路またはmanifestの依存関係を変更"],
      "relatedE2E": ["browser-e2e", "device-e2e"]
    }
  }
}
