    },
    "device": {
      "execution": "parallel-by-context",
      "withinContext": "serial",
      "reason": "端末コンテキストは分離可能だが、各コンテキスト内は保存・復元状態を共有するため",
      "contexts": ["mobile-iphone", "mobile-android", "tablet"],
      "cases": {
        "viewport": ["touch-viewport-css-contract"],
        "interaction": ["touch-swipe", "pointercancel", "consecutive-touch-swipes", "animation-reentry-is-idempotent"],
        "restore": ["dialog-reload-restoration"]
      }
    }
  }
