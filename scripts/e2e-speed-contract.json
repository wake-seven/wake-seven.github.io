      "execution": "serial",
      "reason": "単一ページのlocalStorage・ダイアログ・進行状態を順序どおり共有するため",
      "cases": {
        "smoke": ["startup-and-tutorial-skip", "pointer-swipe-path"],
        "interaction": ["swipe-animation-frame-and-layering", "pointercancel-cancels-board-animation", "concurrent-touch-does-not-replace-drag", "clear-animation-before-dialog-single-display-and-idempotent"],
        "navigation": ["stage-picker-menu-entry", "stage-picker-header-entry", "stage-picker-rank-badge-entry", "stage-picker-rank-entry", "free-mode-entry", "custom-mode-entry"],
        "checkpoint": ["academy-intro-checkpoint", "academy-intro-checkpoint-clear-dialog", "academy-basic-checkpoint", "academy-basic-checkpoint-clear-dialog", "academy-application-checkpoint", "academy-application-checkpoint-clear-dialog", "academy-development-checkpoint", "academy-development-checkpoint-clear-dialog", "training-upper-checkpoint", "training-upper-checkpoint-clear-dialog", "primary-clear-next-action", "primary-clear-reload-next-action", "training-middle-checkpoint", "training-middle-checkpoint-clear-dialog", "training-lower-checkpoint", "training-lower-checkpoint-clear-dialog", "mastery-sequence-checkpoint", "mastery-sequence-checkpoint-clear-dialog", "mastery-break-checkpoint", "mastery-break-checkpoint-clear-dialog", "mastery-rush-checkpoint", "mastery-rush-checkpoint-clear-dialog", "satori-checkpoint", "satori-checkpoint-clear-dialog"],
        "speed": ["speed-question-3-to-4-no-exam-dialog-flash", "speed-reload-restoration"],
        "reward": ["three-d-reward-access-from-vnext-state", "all-patterns-reward-access-from-vnext-state"]
