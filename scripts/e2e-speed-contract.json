{
  "schemaVersion": 1,
  "description": "ブラウザE2Eの現状固定。ケース分類と、将来の並列化で守る状態分離の契約。",
  "reports": {
    "browser": "build/report/browser-e2e-result.json",
    "device": "build/report/device-e2e-result.json"
  },
  "suites": {
