{
  "schemaVersion": 1,
  "javascript": {
    "maxControlLineLength": 160,
    "mode": "warning"
  },
  "css": {
    "format": "one-block-one-line",
    "lineLengthAudit": false
  },
  "excluded": [
    "SVG",
    "data URI",
    "favicon",
    "problem data",
    "multilingual text",
    "generated JSON"
  ]
}
