{
  "schemaVersion": 1,
  "description": "検査の実行区分と時間予算。check:gate は品質を落とさないため全区分を実行する。",
  "profiles": {
    "build-required": {
      "description": "公開物を生成した直後に必ず確認する短い契約",
      "budgetMs": 120000
    },
    "normal-check": {
      "description": "通常の改修で毎回確認する検査",
      "budgetMs": 180000
    },
    "large-change-only": {
      "description": "大規模な構造変更や監査更新時に個別実行する詳細検査",
      "budgetMs": 300000
    }
  },
  "steps": {
    "domain-classification": "build-required",
    "development-entrypoints": "build-required",
    "build": "build-required",
    "version": "build-required",
    "board-domain": "normal-check",
    "application-services": "normal-check",
    "application-targets": "normal-check",
    "state": "normal-check",
    "state-classification": "normal-check",
    "state-mutations": "normal-check",
    "state-restore": "normal-check",
    "browser-flow": "normal-check",
    "dialog-chains": "normal-check",
    "ui-effects": "normal-check",
    "progression-flows": "normal-check",
    "progression-flow-contract": "normal-check",
    "progression-orchestrators": "normal-check",
    "clear-flow-order": "normal-check",
    "esm": "normal-check",
    "source-boundaries": "normal-check",
    "compat-e2e": "normal-check",
    "browser-e2e": "normal-check",
    "device-e2e": "normal-check",
    "gate-evidence": "normal-check",
    "global-access": "large-change-only",
    "state-access-policy": "large-change-only",
    "temporary-exceptions": "large-change-only",
    "refactor-baseline-generate": "large-change-only",
    "structure-contract-diff": "large-change-only",
    "refactor-baseline": "large-change-only",
    "refactor-budgets": "large-change-only",
    "esm-dependencies": "large-change-only",
    "public-esm": "large-change-only",
    "metrics-update-policy": "large-change-only",
    "refactor-policy": "large-change-only",
    "trace": "large-change-only",
    "progression-responsibility": "large-change-only",
    "ui-data-map": "large-change-only",
    "event-wiring": "large-change-only",
    "refactor-report": "large-change-only",
    "compat-boundaries": "large-change-only",
    "unused-files": "large-change-only",
    "manifest-dependencies": "large-change-only",
    "public-symbols": "large-change-only",
    "report-schema": "build-required"
  },
  "groups": {
    "structure": {
      "label": "構造",
      "steps": ["domain-classification", "development-entrypoints", "build", "version", "application-targets", "esm", "source-boundaries", "esm-dependencies", "public-esm", "metrics-update-policy", "refactor-policy", "trace", "ui-data-map", "event-wiring", "refactor-report", "compat-boundaries", "unused-files", "manifest-dependencies", "public-symbols", "report-schema", "structure-contract-diff"]
    },
    "state": {
      "label": "状態",
      "steps": ["state", "state-classification", "state-mutations", "state-restore", "global-access", "state-access-policy", "temporary-exceptions", "refactor-baseline-generate", "refactor-baseline", "refactor-budgets"]
    },
    "flows": {
      "label": "進行",
      "steps": ["board-domain", "application-services", "dialog-chains", "ui-effects", "progression-flows", "progression-flow-contract", "progression-orchestrators", "clear-flow-order", "progression-responsibility"]
    },
    "browser": {
      "label": "ブラウザ",
      "steps": ["browser-flow", "compat-e2e", "browser-e2e", "device-e2e", "gate-evidence"]
    }
  }
}
